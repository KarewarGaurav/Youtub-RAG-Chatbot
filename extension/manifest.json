{
  "manifest_version": 3,
  "name": "YouTube Video RAG AI Assistant",
  "version": "1.0.0",
  "description": "Chat with any YouTube video in real-time using LangChain & Groq Llama 3.1 RAG pipeline.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.youtube.com/*",
    "https://youtu.be/*"
  ],
  "action": {
    "default_title": "YouTube RAG Assistant",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
